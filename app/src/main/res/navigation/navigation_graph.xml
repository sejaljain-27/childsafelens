<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.childsafelens.demo.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signupFragment"
            app:destination="@id/signupFragment" />
        <action
            android:id="@+id/action_loginFragment_to_addChildFragment"
            app:destination="@id/addChildFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_chatFragment"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.childsafelens.demo.ui.auth.SignupFragment"
        android:label="Signup"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signupFragment_to_addChildFragment"
            app:destination="@id/addChildFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/addChildFragment"
        android:name="com.childsafelens.demo.ui.auth.AddChildFragment"
        android:label="Add Child Profile"
        tools:layout="@layout/fragment_add_child">
        <action
            android:id="@+id/action_addChildFragment_to_chatFragment"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/addChildFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.childsafelens.demo.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat">
        <action
            android:id="@+id/action_chatFragment_to_reAuthFragment"
            app:destination="@id/reAuthFragment" />
        <action
            android:id="@+id/action_chatFragment_to_dualChatFragment"
            app:destination="@id/dualChatFragment" />
    </fragment>

    <fragment
        android:id="@+id/reAuthFragment"
        android:name="com.childsafelens.demo.ui.parent.ReAuthFragment"
        android:label="Parent Verification"
        tools:layout="@layout/fragment_re_auth">
        <action
            android:id="@+id/action_reAuthFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:popUpTo="@id/reAuthFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.childsafelens.demo.ui.parent.SettingsFragment"
        android:label="Parent Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_parentDashboardFragment"
            app:destination="@id/parentDashboardFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/chatFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_settingsFragment_to_dualChatFragment"
            app:destination="@id/dualChatFragment" />
    </fragment>

    <fragment
        android:id="@+id/parentDashboardFragment"
        android:name="com.childsafelens.demo.ui.parent.ParentDashboardFragment"
        android:label="Parent Dashboard"
        tools:layout="@layout/fragment_parent_dashboard" />

    <fragment
        android:id="@+id/dualChatFragment"
        android:name="com.childsafelens.demo.ui.chat.DualChatFragment"
        android:label="Dual Chat Simulator"
        tools:layout="@layout/fragment_dual_chat" />
</navigation>
