<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <!-- Top AppBar/Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/chatToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="4dp"
        app:title="Chat Demo"
        app:titleTextColor="@color/text_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView Chat Thread -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/chatToolbar"
        app:layout_constraintBottom_toTopOf="@id/debugControlsHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/chat_message_item_child" />

    <!-- Debug Header -->
    <TextView
        android:id="@+id/debugControlsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Demo Controls: Inject Simulated Incoming Message"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toTopOf="@id/horizontalPresetScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preset Injectors Scroll -->
    <HorizontalScrollView
        android:id="@+id/horizontalPresetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnInjectSafe1"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe 1"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:backgroundTint="#F1F5F9"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnInjectSafe2"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe 2"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:backgroundTint="#F1F5F9"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnInjectModerate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moderate"
                android:textSize="11sp"
                android:textColor="#D97706"
                android:backgroundTint="#FEF3C7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnInjectHigh"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High Risk"
                android:textSize="11sp"
                android:textColor="#DC2626"
                android:backgroundTint="#FEE2E2" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Field -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message…"
            android:background="@android:color/transparent"
            android:paddingVertical="8dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:textColorHint="#94A3B8" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            app:cornerRadius="20dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
