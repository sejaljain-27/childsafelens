<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Risk Status indicator dot -->
        <View
            android:id="@+id/viewRiskIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@android:color/holo_red_dark"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvEventRiskLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH RISK"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626" />

                <TextView
                    android:id="@+id/tvEventDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• OUTGOING"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEventMsgId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source: Chat (id: abc-123)"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEventTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 mins ago"
            android:textSize="12sp"
            android:textColor="#64748B" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
